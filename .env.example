# ====== Windsor.ai ======
# Chave de API encontrada no painel do Windsor.ai (Account > API).
WINDSOR_API_KEY=your_windsor_api_key_here

# ====== Google ======
# Caminho para o JSON da conta de servico (service account) do Google Cloud.
# A conta precisa das APIs Google Sheets, Google Docs e Google Drive habilitadas.
# Compartilhe a planilha/pasta do Drive com o e-mail da service account.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ID da planilha (Google Sheets) usada como painel de controle/indice.
# Encontrado na URL: https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
CONTROL_SPREADSHEET_ID=your_spreadsheet_id_here

# ====== LLM (opcional, melhora os briefings) ======
# Se vazio, os briefings sao gerados apenas com dados/estrutura, sem texto de IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
